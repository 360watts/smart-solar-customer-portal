# 360Watts Customer Portal — required environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Django backend base URL — server-only, never exposed to the browser.
# Used only by auth (login/refresh/logout/register/session). No trailing slash.
API_BASE_URL=https://your-backend-url

# Same backend, but the browser-exposed copy (Next.js requires the
# NEXT_PUBLIC_ prefix to bundle a var into client code). src/lib/api.ts and
# useAssistantStream.ts call this directly from the browser — see
# docs/DIRECT_API_MIGRATION_2026-09.md. Must match API_BASE_URL. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url

# URL of the staff app — staff users who log in here are redirected to this URL.
# Optional; omit if you do not want the redirect hint returned to the browser.
# EMPLOYEE_APP_URL=https://your-staff-app-url

# Set to "false" in local dev when not using HTTPS (production defaults to true).
# AUTH_COOKIE_SECURE=false
